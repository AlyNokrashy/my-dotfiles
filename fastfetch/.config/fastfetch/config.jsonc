{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/de_small.txt",
    "color": {
      "1": "#a7c063",
      "2": "#d3c663"
    }
  },
  "display": {
    "separator": "  ",
    "constants": [
      "─────────────────"
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2
    },
    "color": {
      "keys": "#a7c080",
      "title": "#d3c6aa"
    },
    "percent": {
      "color": {
        "green": "#9da9a0",
        "yellow": "#c8e996",
        "red": "#e67e80"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌{$1} {#1}Hardware Information{#} {$1}┐"
    },
    "host",
    "disk",
    "memory",
    "brightness",
    "battery",
    "poweradapter",
    "sound",
    {
      "type": "custom",
      "format": "├{$1} {#1}Software Information{#} {$1}┤"
    },
    {
      "type": "title",
      "keyIcon": "",
      "key": "Title",
      "format": "{user-name}@{host-name}"
    },
    "os",
    "de",
    "wm",
    "shell",
    "terminal",
    "icons",
    "wallpaper",
    "packages",
    "uptime",
    {
      "type": "localip",
      "compact": true
    },
    {
      "type": "publicip",
      "timeout": 1000,
      "compact": true
    },
    {
      "type": "wifi",
      "format": "{ssid}"
    },
    {
      "type": "custom",
      "format": "└{$1}──────────────────────{$1}┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
