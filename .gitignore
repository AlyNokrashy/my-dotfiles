# ---- Noctalia-generated theme outputs (regenerated on theme change; never commit) ----
# leaf user template output
leaf/.config/leaf/noctalia.toml
# builtin template outputs
btop/.config/btop/themes/noctalia.theme
hypr/.config/hypr/noctalia.lua
kitty/.config/kitty/themes/noctalia.conf
# starship output (STARSHIP_CONFIG=$ZDOTDIR/starship.toml, inside the zsh package)
zsh/.config/zsh/starship.toml
# community template outputs
fastfetch/.config/fastfetch/themes/noctalia.jsonc
yazi/.config/yazi/flavors/noctalia.yazi/flavor.toml
yazi/.config/yazi/flavors/noctalia.yazi/tmtheme.xml

# ---- zsh: auto-cloned plugins (by zsh/.config/zsh/plugins.zsh) and compinit cache ----
zsh/.config/zsh/plugins/
zsh/.config/zsh/.zcompdump*

# ---- stray local backups ----
*.bak
